{
  // ───────────── Appearance ─────────────
  "theme": "One Dark",
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 15.0,
  "buffer_font_family": "Fira Code",
  "buffer_font_size": 13.0,
  // Alternatives:
  // "buffer_font_family": "CommitMono", "buffer_font_size": 13.0
  // "buffer_font_family": "Iosevka SS08", "buffer_font_size": 15.0

  // ───────────── Editor ─────────────
  "cursor_blink": false,
  "current_line_highlight": "all",
  "wrap_guides": [100],
  "format_on_save": "off",

  // ───────────── Keyboard ─────────────
  "base_keymap": "VSCode",
  "vim_mode": true,

  // ───────────── Workspace / UI ─────────────
  "cli_default_open_behavior": "existing_window",
  "tab_bar": { "show_nav_history_buttons": false },
  "tabs": { "file_icons": true },
  "project_panel": {
    "dock": "left",
    "git_status_indicator": true,
  },
  "git_panel": { "dock": "left" },
  "git": { "git_gutter": "tracked_files" },

  // ───────────── AI / Privacy / Trust ─────────────
  "disable_ai": true,
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
}
