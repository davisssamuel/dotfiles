{
  // Interface
  "theme": "One Light",
  "title_bar": {},
  "tab_bar": { "show_nav_history_buttons": false },
  "tabs": { "file_icons": true },
  "git": { "git_gutter": "tracked_files" },
  "wrap_guides": [100],

  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },

  // Font
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 15.0,
  "buffer_font_family": "CommitMono",
  "buffer_font_size": 13.0,

  // Cursor
  "cursor_blink": false,
  "current_line_highlight": "all",

  // Keymap
  "base_keymap": "VSCode",
  "vim_mode": true,
  "format_on_save": "off",

  // Other
  "disable_ai": false,
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },

  // LSP
  // "lsp": {
  //   "jdtls": {
  //     "settings": {
  //       "java.project.sourcePaths": ["src"]
  //     }
  //   }
  // }
}
