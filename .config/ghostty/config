# Theme and Font
theme = GitHub-Dark-Dimmed
font-family = CommitMono
font-feature = -calt, -liga, -dlig

# Window
window-width = 80
window-height = 24
window-padding-x = 20
window-padding-y = 10
adjust-cell-height = 20%
adjust-cursor-height = 20%

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-color = #8A949E
shell-integration-features = no-cursor
